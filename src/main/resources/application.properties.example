spring.datasource.url=jdbc:mysql://localhost:3306/gymtracker?createDatabaseIfNotExist=true
spring.datasource.username=root
spring.datasource.password=PASSWORDMYSQL

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
gymtracker.jwt.segreto=${GYM_JWT_SEGRETO:}
gymtracker.codice-invito=${GYM_CODICE_INVITO:}

gymtracker.push.chiave-pubblica=${GYM_PUSH_PUBBLICA:}
gymtracker.push.chiave-privata=${GYM_PUSH_PRIVATA:}
gymtracker.push.soggetto=${GYM_PUSH_SOGGETTO:}

spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=${GYM_MAIL_UTENTE:}
spring.mail.password=${GYM_MAIL_PASSWORD:}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

server.port=8080